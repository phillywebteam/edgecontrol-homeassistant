{
  "id": "com.phillywebteam.homeassistant",
  "name": "Home Assistant",
  "version": "1.6.0",
  "author": "Mason Miller",
  "description": "Tap-to-run buttons for Home Assistant scenes, scripts, automations and devices",
  "icon": "house.fill",
  "minAppVersion": "2.5.0",
  "permissions": [
    "network-access",
    "storage"
  ],
  "widgets": [
    {
      "id": "buttons",
      "name": "Home Assistant Buttons",
      "description": "Buttons for the scenes, scripts, automations and devices you pick",
      "icon": "square.grid.2x2.fill",
      "htmlFile": "widget.html",
      "supportedSizes": {
        "min": [
          1,
          1
        ],
        "max": [
          20,
          6
        ]
      },
      "defaultSize": [
        6,
        2
      ],
      "refreshInterval": 2.0,
      "configSchema": [
        {
          "key": "haUrl",
          "label": "Home Assistant URL (blank: use another Buttons tile’s)",
          "type": "string",
          "default": ""
        },
        {
          "key": "accessToken",
          "label": "Long-lived access token (blank: use another Buttons tile’s)",
          "type": "string",
          "default": ""
        },
        {
          "key": "title",
          "label": "Tile title (optional)",
          "type": "string",
          "default": ""
        },
        {
          "key": "style",
          "label": "Style",
          "type": "select",
          "default": "Cards",
          "options": [
            "Cards",
            "Dividers",
            "Pills",
            "Minimal",
            "Tinted"
          ]
        },
        {
          "key": "layout",
          "label": "Button grid (columns × rows)",
          "type": "select",
          "default": "Auto",
          "options": [
            "Auto",
            "1 × 1",
            "2 × 1",
            "3 × 1",
            "4 × 1",
            "5 × 1",
            "6 × 1",
            "8 × 1",
            "10 × 1",
            "1 × 2",
            "2 × 2",
            "3 × 2",
            "4 × 2",
            "5 × 2",
            "6 × 2",
            "8 × 2",
            "10 × 2",
            "2 × 3",
            "3 × 3",
            "4 × 3",
            "5 × 3",
            "6 × 3",
            "8 × 3",
            "10 × 3"
          ]
        },
        {
          "key": "buttonSet",
          "label": "Shared button set (blank: this tile’s own buttons)",
          "type": "string",
          "default": ""
        },
        {
          "key": "buttonColor",
          "label": "Button color",
          "type": "select",
          "default": "Theme accent",
          "options": [
            "Theme accent",
            "Cyan",
            "Blue",
            "Purple",
            "Green",
            "Yellow",
            "Orange",
            "Red",
            "Pink",
            "White"
          ]
        },
        {
          "key": "showState",
          "label": "Show device state",
          "type": "boolean",
          "default": true
        },
        {
          "key": "confirmRisky",
          "label": "Tap twice to unlock or open doors",
          "type": "boolean",
          "default": true
        }
      ]
    }
  ]
}
